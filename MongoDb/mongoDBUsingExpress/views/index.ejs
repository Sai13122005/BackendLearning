<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
        <h2>All Chats</h2>
        <form action="/chat/new">
            <button>new chat</button>
        </form>
        <% for(let chat of chats) {%>
            <div class="chat">
                <p>From : <i><%= chat.from %></i></p>
                <div class="msg">
                    <p>message : <%= chat.message %></p>
                    <form method="get" action="/chat/<%=chat._id%>/edit">
                        <button>Edit</button>
                    </form>
                </div>
                <p>recieved by : <i><%= chat.to %></i></p>
                <form method="post" action="/chat/<%=chat._id%>?_method=DELETE">
                    <button>Delete</button>
                </form>
                <hr>
                <!-- time -->
                <p><%=chat.created_at.toString().split(" ")[4]%></p>
                <!-- Date -->
                <p><%=chat.created_at.toString().split(" ").slice(0, 4).join(" ")%></p>

            </div>
            <br><br>
        <% } %>
</body>
</html>