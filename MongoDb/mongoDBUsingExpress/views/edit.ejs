<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit</title>
</head>
<body>
    <h2>Edit your message</h2>
    <form method="post" action="/chat/<%= chat._id %>?_method=PUT">
        <textarea name="message"><%= chat.message %></textarea>
        <br><br>
        <button>Update</button>
    </form>
</body>
</html>